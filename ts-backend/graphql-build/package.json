{
  "name": "boilerplate",
  "version": "0.0.1",
  "description": "Awesome project developed with TypeORM.",
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-redis": "^0.0.23",
    "@types/express-session": "^1.19.0",
    "@types/faker": "^6.6.11",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/node-fetch": "^2.6.13",
    "@types/sparkpost": "^2.1.9",
    "@types/uuid": "^11.0.0",
    "@types/yup": "^0.32.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@gql2ts/from-schema": "^1.10.1",
    "bcryptjs": "^3.0.3",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "faker": "^6.6.6",
    "global": "^4.4.0",
    "gql2ts": "^1.10.1",
    "graphql": "^17.0.2",
    "graphql-import": "^1.0.2",
    "graphql-request": "^7.4.0",
    "graphql-tools": "^9.0.35",
    "graphql-yoga": "^5.22.0",
    "ioredis": "^6.0.0",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.14",
    "npm-check-updates": "^23.1.0",
    "parse5-htmlparser2-tree-adapter": "^8.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "sparkpost": "^2.1.4",
    "start-server-and-test": "^3.0.12",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typeorm": "1.1.1",
    "uuid": "^14.0.2",
    "yup": "^1.7.1"
  },
  "scripts": {
    "start": "NODE_ENV=development nodemon --exec ts-node src/index.ts",
    "test-server": "NODE_ENV=test ts-node src/index.ts",
    "test": "NODE_ENV=development jest --watch",
    "gen-schema-types": "ts-node ./src/scripts/createTypes.ts",
    "ci": "start-server-and-test test-server http://localhost:4000 test"
  },
  "jest": {
    "globalSetup": "./src/test/callSetup.js",
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
